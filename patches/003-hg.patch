+  /**
+   * Ensures ~/.local/bin/arc-hg.py exists or throws an exception
+   * explaining why that failed.
+   *
+   * @return string
+   */
+  private function ensureArcHgExists(): string {
+    $home = getenv('HOME');
+
+    if (!phutil_nonempty_string($home)) {
+      throw new PhutilArgumentUsageException(
+        pht(
+          'The "HOME" environment variable is not defined, so this command '.
+          'can not identify where to install arc extensions for Mercurial.'));
+    }
+
+    $path = $home.'/.local/bin/arc-hg.py';
+
+    Filesystem::writeFileIfChanged(
+      $path,
+      Filesystem::readFile(Phar::running(false).'/support/hg/arc-hg.py'));
+
+    return $path;
+  }
