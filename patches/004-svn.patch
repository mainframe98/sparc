+  private function ensureBinarySafeDiffExists(): string {
+    $home = getenv('HOME');
+
+    if (!phutil_nonempty_string($home)) {
+      throw new PhutilArgumentUsageException(
+        pht(
+          'The "HOME" environment variable is not defined, so this command '.
+          'can not identify where to install diff extensions for SVN.'));
+    }
+
+    $path = $home.'/.local/bin/arc-svn-binary-safe-diff.py';
+
+    Filesystem::writeFileIfChanged(
+      $path,
+      Filesystem::readFile(
+        Phar::running(false).'/scripts/repository/binary_safe_diff.sh'));
+
+    return $path;
+  }
